<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>

<!--
  Container only. The rail's contents are built by SidebarController, because it
  has two forms - expanded with labels and group headings, collapsed to icons -
  and keeping one set of nodes that switches between them is less error-prone
  than keeping two markup trees in step.
-->
<VBox fx:id="sidebar"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      styleClass="sidebar"/>
